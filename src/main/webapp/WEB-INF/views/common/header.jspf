<%--
    Shared <head> + navigation bar.

    WHY a .jspf fragment instead of copying this into every page:
    The navbar, the Bootstrap CDN links and the favicon are identical everywhere.
    Duplicating them across eight pages means an edit in one place and a stale
    copy in seven. <%@ include %> is a STATIC include - the fragment is merged
    into the page at COMPILE time, so there is no runtime include and no
    performance cost. That is why this is a fragment and not a separate page
    that we forward to.
--%>
<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<%--
    Set by a servlet before a forward/redirect? No - request attributes do not
    survive a redirect. For a redirect the servlet uses SessionUtil.setFlash(),
    which is read just below and then removed (one-shot).
--%>
<c:set var="flash" value="${sessionScope.bloodConnectFlash}"/>
<c:remove var="flash" scope="session"/>

<%--
    The logged-in user's name and role, read straight from the session with EL.
    No scriptlet, no Java code, no <% %> tag anywhere in the view layer.
    SessionUtil is what put these two keys there, and only SessionUtil knows
    their names.
--%>
<c:set var="currentUserId" value="${sessionScope.bloodConnectUserId}"/>
<c:set var="currentRole" value="${sessionScope.bloodConnectUserRole}"/>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${pageTitle}" default="Emergency Blood &amp; Donor Coordination"/> &middot; BloodConnect</title>
    <link rel="icon" type="image/svg+xml" href="${pageContext.request.contextPath}/assets/favicon.svg">

    <!-- Bootstrap 5 from a CDN, as required. integrity/crossorigin omitted on
         purpose: pinning them would break the moment the CDN rotates a build. -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="${pageContext.request.contextPath}/assets/css/app.css" rel="stylesheet">
</head>
<body class="bg-body-tertiary d-flex flex-column min-vh-100">

<nav class="navbar navbar-expand-lg bg-white border-bottom shadow-sm">
    <div class="container">
        <a class="navbar-brand fw-bold text-danger d-flex align-items-center gap-2"
           href="${pageContext.request.contextPath}/index.jsp">
            <img src="${pageContext.request.contextPath}/assets/favicon.svg" alt="" width="26" height="26">
            BloodConnect
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain"
                aria-controls="navMain" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navMain">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" href="${pageContext.request.contextPath}/index.jsp">Home</a>
                </li>
            </ul>

            <ul class="navbar-nav align-items-lg-center">
                <%--
                    WHY the c:choose chain: exactly one of the two states is true.
                    c:if alone would need the inverse condition, and writing
                    "not logged in" twice is how the two branches drift apart.
                --%>
                <c:choose>
                    <c:when test="${not empty currentUserId}">
                        <li class="nav-item">
                            <span class="navbar-text me-3">
                                Signed in as <strong><c:out value="${sessionScope.bloodConnectUserName}"/></strong>
                                <span class="badge text-bg-secondary ms-1"><c:out value="${currentRole}"/></span>
                            </span>
                        </li>
                        <%--
                            WHY the link uses the path the MODEL computed
                            (sessionScope.bloodConnectDashboardPath) rather than being
                            rebuilt here as /${role}/dashboard:
                            the path is decided by User.getDashboardPath() at runtime.
                            Re-deriving it in the view would duplicate that rule in a
                            second place, and the two could disagree. Reading the cached
                            value keeps exactly one source of truth.
                        --%>
                        <li class="nav-item">
                            <a class="nav-link fw-semibold"
                               href="${pageContext.request.contextPath}${sessionScope.bloodConnectDashboardPath}">
                                Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-sm btn-outline-secondary"
                               href="${pageContext.request.contextPath}/logout">Sign out</a>
                        </li>
                    </c:when>
                    <c:otherwise>
                        <li class="nav-item">
                            <a class="nav-link" href="${pageContext.request.contextPath}/login.jsp">Sign in</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-sm btn-danger"
                               href="${pageContext.request.contextPath}/register.jsp">Register</a>
                        </li>
                    </c:otherwise>
                </c:choose>
            </ul>
        </div>
    </div>
</nav>

<%--
    Flash message. Rendered by Bootstrap's .alert, and it only ever appears once
    because the fragment removes the session attribute as it reads it.
--%>
<c:if test="${not empty flash}">
    <div class="container mt-3">
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <c:out value="${flash}"/>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
</c:if>

<main class="flex-grow-1">
